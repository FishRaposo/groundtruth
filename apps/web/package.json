{
  "name": "groundtruth-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium --project=mobile-chromium",
    "check": "npm test && npm run lint && npm run build && npm run test:e2e:chromium"
  },
  "dependencies": {
    "clsx": "^2.1.0",
    "lucide-react": "^0.330.0",
    "next": "16.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^9.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.41.0",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^14.2.0",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "5.2.0",
    "autoprefixer": "^10.4.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "jsdom": "^24.0.0",
    "postcss": "8.5.26",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
