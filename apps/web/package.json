{
  "name": "groundtruth-frontend",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "demo:ui": "cross-env NEXT_PUBLIC_DEMO_MODE=true next dev -p 3505",
    "build": "next build",
    "start": "node scripts/start-production.mjs",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium --project=mobile-chromium",
    "check": "npm test && npm run lint && npm run build && npm run test:e2e:chromium",
    "test:e2e:sample": "playwright test",
    "test:e2e:live": "playwright test --config=playwright.live.config.ts"
  },
  "dependencies": {
    "clsx": "^2.1.0",
    "lucide-react": "^0.545.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^9.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20.11.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "autoprefixer": "^10.4.0",
    "cross-env": "^7.0.3",
    "eslint": "9.39.5",
    "eslint-config-next": "^16.4.2",
    "jsdom": "^24.0.0",
    "postcss": "8.5.26",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.0",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
