apps/api/app/portfolio/assets/coverage-*/*.json -text
docs/evidence/answer-coverage-v2/*.json -text
docs/evidence/answer-coverage-v2/*.sha256 -text
docs/evidence/answer-coverage-v2/*.md text eol=lf
