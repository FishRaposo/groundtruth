docs/evidence/answer-coverage-v2/*.zip binary
apps/web/public/evidence/evidence/answer-coverage-v2/* -text
docs/evidence/portfolio/*.json text eol=lf
docs/evidence/portfolio/*.md text eol=lf
docs/evidence/portfolio/*.png binary
