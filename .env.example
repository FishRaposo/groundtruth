# GroundTruth Environment Configuration

# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://groundtruth:groundtruth_dev@localhost:5432/groundtruth
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=groundtruth
DATABASE_USER=groundtruth
DATABASE_PASSWORD=groundtruth_dev

# ── LLM Configuration ────────────────────────────────────
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# ── Embedding Settings ────────────────────────────────────
EMBEDDING_DIMENSIONS=384
EMBEDDING_MODE=deterministic
LOCAL_MODEL_PATH=
LOCAL_MODEL_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
GENERATION_MODE=extractive
INGESTION_MODE=inline
STORAGE_ROOT=.tmp/portfolio/uploads

# Optional local CPU evidence support: install groundtruth[support], then run
# python -m app.support_setup --directory <model-directory> explicitly.
# Runtime and the portable launcher never download support model assets.
ANSWER_SUPPORT_MODE=disabled
PROCEDURE_VERIFICATION_PROFILE=all_units_nli_v1
# Explicit alternative: source_declared_procedure_copy_v1 requires reader,
# local_nli and extractive generation. It never bypasses missing model assets.
SUPPORT_MODEL_PATH=
SUPPORT_MODEL_REVISION=70de96bd327ef95839a8bd9f6299875cae396433
# Raw entailment-minus-max(other labels) margin; uncalibrated, allowed0..4.
SUPPORT_MIN_MARGIN=4

# ── Chunking Settings ────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ── Retrieval Settings ───────────────────────────────────
RETRIEVAL_TOP_K=5
SIMILARITY_THRESHOLD=0.7

# ── Refusal Settings ─────────────────────────────────────
REFUSAL_CONFIDENCE_THRESHOLD=0.5
CONNECTED_REFUSAL_THRESHOLD=0.35

# ── Application ──────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
AUTH_ENABLED=true
CORS_ORIGINS=http://localhost:3505,http://127.0.0.1:3505
